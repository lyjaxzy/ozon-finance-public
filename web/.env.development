# 本地环境
VITE_USER_NODE_ENV = development

# 公共基础路径
VITE_PUBLIC_PATH = /

# 路由模式
# Optional: hash | history
VITE_ROUTER_MODE = hash

# 打包时是否删除 console
VITE_DROP_CONSOLE = true

# 是否开启 VitePWA
VITE_PWA = false

# 开发环境接口地址（真实后端走 vite dev 代理，见 vite.config.ts 的 server.proxy）
VITE_API_URL = /api

# 开发环境跨域代理，支持配置多个
# ⚠️ 真实后端（api/，FastAPI）的代理**写死在 vite.config.ts 里**，不走这个变量：
#    脚手架自带的 createProxy 会 rewrite 掉 `/api` 前缀，而后端路由本身就带 `/api`。
#    下面这条 mock 代理已被 vite.config.ts 中的 `/api` 覆盖，保留仅作历史参考。
VITE_PROXY = []
# 历史 mock：VITE_PROXY = [["/api","https://m1.apifoxmock.com/m1/2573367-1654163-8288883"]]
