#!/bin/sh
# ─────────────────────────────────────────────────────────────────────
# pre-push 门禁
#
# 目的：**不允许把没验证过的代码推离本机**。
# 推送是"离开本机"的动作，一旦上去就收不回（尤其公开仓库），
# 所以门禁比本地提交更严：一律跑完整回归（夹具 + 生产库全量对账）。
#
# 与 pre-commit / pre-merge-commit 共用 _gate.sh，避免三份逻辑漂移。
# 绕过：git push --no-verify
# ─────────────────────────────────────────────────────────────────────
set -u
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$here/_gate.sh" push
