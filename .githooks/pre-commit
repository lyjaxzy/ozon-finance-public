#!/bin/sh
# ─────────────────────────────────────────────────────────────────────
# pre-commit —— 普通提交门禁入口（模式 commit）
#
# 真正的逻辑在 _gate.sh，避免两份实现各自漂移。
# 本文件保持极薄：只负责确定自身位置并转发。
#
# 时序说明（实测，不是推测）：
#   Git 对合并产生的提交会调用 pre-merge-commit；本文件在普通提交时被调用。
#   模式由入口显式传入，不依赖 MERGE_HEAD —— 实测 pre-merge-commit 执行时
#   .git/MERGE_HEAD 尚未写入，靠它判断会把合并误判成普通提交，
#   结果是分支守卫先拦下来：合并虽然失败了，但失败理由是错的、测试门禁根本没跑。
#
# 绕过：git commit --no-verify
# ─────────────────────────────────────────────────────────────────────
set -u
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$here/_gate.sh" commit
