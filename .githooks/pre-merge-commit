#!/bin/sh
# ─────────────────────────────────────────────────────────────────────
# pre-merge-commit —— 合并进 main 的门禁入口（模式 merge）
#
# 真正的逻辑在 _gate.sh，与 pre-commit 共用，避免两份实现各自漂移。
#
# 为什么合并要用独立入口、且必须传 merge 模式：
#   merge 模式下允许在 main 上产生提交（合并本来就该落在 main），
#   并跑完整回归；而普通提交模式在 main 上会被分支守卫直接拒绝。
#
# 绕过：git merge --no-verify
# ─────────────────────────────────────────────────────────────────────
set -u
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$here/_gate.sh" merge
